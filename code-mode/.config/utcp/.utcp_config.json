{
  "load_variables_from": [
    {
      "variable_loader_type": "dotenv",
      "env_file_path": "/home/stefano/.config/utcp/.env"
    }
  ],
  "manual_call_templates": [
    {
      "name": "openclaw-mcp",
      "call_template_type": "mcp",
      "config": {
        "mcpServers": {
          "openclaw": {
            "transport": "stdio",
            "command": "pnpx",
            "args": [
	      "openclaw",
	      "mcp",
	      "serve",
	      "--url",
	      "https://openclaw.home.142142142.xyz",
	      "--token-file",
	      ".openclaw/gateway.token"
            ]
          }
        }
      }
    },
    {
      "name": "truenas-mcp",
      "call_template_type": "mcp",
      "config": {
        "mcpServers": {
          "truenas": {
            "transport": "stdio",
            "command": "/bin/sh",
            "args": [
              "-c",
              "set -a; . /home/stefano/.truenas.env; set +a; exec /home/stefano/.local/bin/truenas-mcp-linux-amd64 --insecure"
            ]
          }
        }
      }
    },
    {
      "name": "rea",
      "call_template_type": "mcp",
      "config": {
        "mcpServers": {
          "rea": {
            "transport": "stdio",
            "command": "/home/stefano/.local/share/pnpm/bin/rea",
            "args": [
              "mcp"
            ],
            "env": {
              "GHIDRA_INSTALL_DIR": "/opt/ghidra",
	      "JAVA_HOME": "/usr/lib/jvm/java-27-openjdk",
              "HOPPER_LAUNCHER_PATH": "/opt/hopper/bin/Hopper"
            }
          }
        }
      }
    },
    {
      "name": "qgis",
      "call_template_type": "mcp",
      "config": {
        "mcpServers": {
          "qgis": {
            "transport": "stdio",
            "command": "/home/stefano/.local/share/pnpm/bin/rea",
            "args": [
		"--directory",
		"/home/stefano/Projects/qgis_mcp/src/qgis_mcp",
		"run",
		"qgis_mcp_server.py"
            ]
          }
        }
      }
    }
  ]
}
